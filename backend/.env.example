# Copy this file to .env and fill in real values before running.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/epicenter

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Optional: enables POST /api/disasters/{id}/summarize ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Scheduler ---
ETL_SCHEDULE_HOURS=24
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_month.geojson
